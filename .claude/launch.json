{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "carbon-gap",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8010",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--timeout-graceful-shutdown",
        "2"
      ],
      "port": 8010
    }
  ]
}